{
  "name": "base-node-starter",
  "version": "0.0.1",
  "description": "Base Node Starter Package with Leapfrog Lint and Prettier",
  "main": "index.js",
  "author": "Biplap Bhattarai <bhattaraib58@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhattaraib58/base-node-starter.git"
  },
  "keywords": [],
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "nodemon --watch .env --watch src --exec babel-node src --source-maps",
    "build": "rimraf dist && babel src -D --out-dir dist",
    "eslint": "eslint \"{src,api,public}/**/*.{js,jsx}\"",
    "eslint:fix": "eslint --fix \"{src,api,public}/**/*.{js,jsx}\"",
    "lint": "npm run prettier && npm run eslint",
    "lint:fix": "npm run prettier:fix && npm run eslint:fix",
    "prettier": "prettier --list-different \"{src,api,public}/**/*.{js,jsx,html,css,md,yml,yml,json}\" --loglevel warn",
    "prettier:fix": "prettier --write \"{src,api,public}/**/*.{js,jsx,html,css,md,yml,yml,json}\" --loglevel warn",
    "bootstrap": "echo 'Removing node_modules...' && rm -rf node_modules && npm i",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,md,yml,yml,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "response-time": "^2.3.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "eslint": "^10.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
